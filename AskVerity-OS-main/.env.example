# AskVerity OS — optional configuration
# Copy this file to `.env` and edit it. Every value is optional; the desktop
# works with no configuration at all (it falls back to Verity's demo brain).

# Assistant provider:
#   ollama = talk to a model running on your own computer (free, private)
#   mock   = use the built-in demo brain (no internet, no model required)
AI_PROVIDER=ollama

# Your local Ollama endpoint and the model you have pulled.
# See https://ollama.com — `ollama pull llama3.2` installs the default.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Give up on a slow local model after this many milliseconds.
OLLAMA_TIMEOUT_MS=60000

# Web server settings.
PORT=3000
HOST=0.0.0.0
